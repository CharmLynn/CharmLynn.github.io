---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const paletteItems = [
  {
    group: '文章 / Writing',
    items: posts.map((post) => ({
      title: post.data.title,
      subtitle: post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.'),
      href: `/blog/${post.id}/`,
      keywords: `${post.data.title} ${post.data.tags.join(' ')} ${post.data.description}`,
    })),
  },
  {
    group: '项目 / Projects',
    items: [
      {
        title: 'SaveAnswer — 本地优先 AI 知识库扩展',
        subtitle: '/saveanswer/',
        href: '/saveanswer/',
        keywords: 'saveanswer chrome extension obsidian local-first ai 知识库 插件',
      },
      {
        title: '全部自研项目一览',
        subtitle: '/projects',
        href: '/projects',
        keywords: 'projects 作品 开源',
      },
    ],
  },
  {
    group: '导航与操作 / Navigation',
    items: [
      { title: '返回首页', subtitle: '/', href: '/', keywords: 'home index 首页' },
      { title: '全部文章列表', subtitle: '/blog', href: '/blog', keywords: 'blog writing 文章 博客' },
      { title: '关于庄谷 (charmlynn)', subtitle: '/about', href: '/about', keywords: 'about bio 关于 简介' },
      { title: '2018 历史技术归档', subtitle: '/archive', href: '/archive', keywords: 'archive 2018 归档 旧文' },
      { title: '切换阅读外观 (浅色纸张 / 暮色石墨)', subtitle: 'Theme', action: 'toggle-theme', keywords: 'theme dark light 主题 深色 浅色' },
      { title: '复制联系邮箱 (flvictory@gmail.com)', subtitle: 'Copy', action: 'copy-email', keywords: 'email contact 邮箱 联系' },
      { title: 'RSS 订阅源', subtitle: '/rss.xml', href: '/rss.xml', keywords: 'rss feed subscribe 订阅' },
    ],
  },
];
---

<div
  id="cmd-backdrop"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-[13vh] px-4"
  style="background: rgba(14, 17, 16, 0.36); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
  role="dialog"
  aria-modal="true"
  aria-label="快速跳转面板"
>
  <div
    id="cmd-dialog"
    class="w-full max-w-[540px] overflow-hidden rounded-xl"
    style="background: var(--bg-modal); box-shadow: var(--shadow-modal);"
  >
    <!-- Input Bar -->
    <div class="flex items-center gap-3 px-4 h-13 border-b" style="border-color: var(--border-hairline);">
      <svg class="w-4 h-4 shrink-0" style="color: var(--ink-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="cmd-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="搜索文章、项目或输入指令..."
        class="w-full bg-transparent text-[15px] outline-none placeholder:text-[var(--ink-faint)]"
        style="color: var(--ink);"
      />
      <button
        id="cmd-close"
        type="button"
        class="kbd-cap cursor-pointer shrink-0 hover:opacity-80"
        aria-label="关闭面板"
      >
        ESC
      </button>
    </div>

    <!-- Results List -->
    <div id="cmd-list" class="max-h-[340px] overflow-y-auto p-2 space-y-3" role="listbox">
      {paletteItems.map((section) => (
        <div class="cmd-group space-y-0.5">
          <div class="px-2.5 py-1 text-[12px] font-medium" style="color: var(--ink-faint);">
            {section.group}
          </div>
          {section.items.map((item) => (
            <button
              type="button"
              role="option"
              data-href={item.href || ''}
              data-action={item.action || ''}
              data-keywords={(item.keywords || '').toLowerCase()}
              class="cmd-option w-full flex items-center justify-between gap-3 px-2.5 py-2 rounded-lg text-left text-[14px] cursor-pointer transition-colors"
              style="color: var(--ink-secondary);"
            >
              <span class="truncate font-normal cmd-title" style="color: var(--ink);">{item.title}</span>
              <span class="font-tabular text-[12px] shrink-0" style="color: var(--ink-faint);">{item.subtitle}</span>
            </button>
          ))}
        </div>
      ))}
      <div id="cmd-empty" class="hidden py-8 text-center text-[14px]" style="color: var(--ink-muted);">
        未找到匹配的内容，试试搜索 “Local-first” 或 “SaveAnswer”
      </div>
    </div>

    <!-- Footer Hints -->
    <div
      class="flex items-center justify-between px-4 py-2 text-[12px] border-t"
      style="border-color: var(--border-hairline); color: var(--ink-faint); background: var(--bg-subtle);"
    >
      <span>支持键盘快速检索跳转</span>
      <div class="flex items-center gap-3 font-tabular">
        <span>↑↓ 选择</span>
        <span>↵ 打开</span>
      </div>
    </div>
  </div>
</div>

<!-- Subtle Toast for Copy Feedback -->
<div
  id="site-toast"
  class="fixed bottom-6 right-6 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 px-3.5 py-2 rounded-lg text-[13px] font-medium"
  style="background: var(--ink); color: var(--bg-canvas); box-shadow: var(--shadow-lift);"
  role="status"
  aria-live="polite"
>
  已复制到剪贴板
</div>

<style>
  .cmd-option[data-active="true"],
  .cmd-option:hover {
    background-color: var(--bg-subtle);
  }
  .cmd-option[data-active="true"] .cmd-title {
    color: var(--accent) !important;
    font-weight: 500;
  }
</style>

<script is:inline>
  (() => {
    const backdrop = document.getElementById('cmd-backdrop');
    const input = document.getElementById('cmd-input');
    const closeBtn = document.getElementById('cmd-close');
    const emptyState = document.getElementById('cmd-empty');
    const toast = document.getElementById('site-toast');
    if (!backdrop || !input) return;

    const allOptions = Array.from(backdrop.querySelectorAll('.cmd-option'));
    const groups = Array.from(backdrop.querySelectorAll('.cmd-group'));
    let activeIndex = 0;

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 1800);
    }
    window.__showSiteToast = showToast;

    function visibleOptions() {
      return allOptions.filter((el) => !el.classList.contains('hidden'));
    }

    function updateActive(index) {
      const vis = visibleOptions();
      allOptions.forEach((el) => el.removeAttribute('data-active'));
      if (!vis.length) return;
      activeIndex = ((index % vis.length) + vis.length) % vis.length;
      vis[activeIndex].setAttribute('data-active', 'true');
      vis[activeIndex].scrollIntoView({ block: 'nearest' });
    }

    function openPalette() {
      backdrop.classList.remove('hidden');
      backdrop.classList.add('flex');
      input.value = '';
      filterOptions('');
      requestAnimationFrame(() => input.focus());
    }

    function closePalette() {
      backdrop.classList.add('hidden');
      backdrop.classList.remove('flex');
    }

    function filterOptions(query) {
      const q = query.trim().toLowerCase();
      allOptions.forEach((opt) => {
        const text = (opt.textContent || '').toLowerCase();
        const kw = opt.getAttribute('data-keywords') || '';
        const match = !q || text.includes(q) || kw.includes(q);
        opt.classList.toggle('hidden', !match);
      });
      groups.forEach((g) => {
        const hasVisible = g.querySelectorAll('.cmd-option:not(.hidden)').length > 0;
        g.classList.toggle('hidden', !hasVisible);
      });
      const vis = visibleOptions();
      if (emptyState) emptyState.classList.toggle('hidden', vis.length > 0);
      updateActive(0);
    }

    function executeOption(opt) {
      if (!opt) return;
      const href = opt.getAttribute('data-href');
      const action = opt.getAttribute('data-action');
      closePalette();
      if (href) {
        window.location.href = href;
      } else if (action === 'toggle-theme' && window.__toggleSiteTheme) {
        window.__toggleSiteTheme();
      } else if (action === 'copy-email') {
        navigator.clipboard?.writeText('flvictory@gmail.com');
        showToast('已复制邮箱 flvictory@gmail.com');
      }
    }

    document.querySelectorAll('[data-open-cmd]').forEach((btn) => {
      btn.addEventListener('click', openPalette);
    });

    closeBtn?.addEventListener('click', closePalette);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closePalette();
    });

    input.addEventListener('input', (e) => filterOptions(e.target.value));

    allOptions.forEach((opt) => {
      opt.addEventListener('click', () => executeOption(opt));
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('hidden')) openPalette();
        else closePalette();
        return;
      }
      if (backdrop.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateActive(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateActive(activeIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const vis = visibleOptions();
        executeOption(vis[activeIndex]);
      }
    });
  })();
</script>
