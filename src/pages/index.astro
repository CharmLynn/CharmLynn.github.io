---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <div class="space-y-12">
    <!-- 1. 个人介绍 -->
    <section class="space-y-4">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-stone-900">
        庄谷 <span class="text-stone-400 font-normal text-lg sm:text-xl font-mono">/ charmlynn</span>
      </h1>
      <p class="text-stone-600 leading-relaxed text-base">
        全栈工程师与独立开发者。关注大模型应用、本地优先（Local-first）工作流与开发者生产力工具。喜欢打磨切实解决自己痛点的小工具，把思考沉淀为代码与文字。
      </p>
    </section>

    <!-- 2. 近期关注与在做的项目 (简炼呈现，不喧宾夺主) -->
    <section class="space-y-4 pt-2">
      <div class="flex items-baseline justify-between border-b border-stone-200/80 pb-2">
        <h2 class="text-xs font-mono uppercase tracking-wider text-stone-500 font-medium">近期项目</h2>
        <a href="/projects" class="text-xs text-stone-400 hover:text-stone-700 transition-colors">
          全部项目 →
        </a>
      </div>

      <ul class="space-y-4">
        <li class="space-y-1">
          <div class="flex items-center gap-2">
            <a
              href="/saveanswer/"
              class="font-medium text-stone-900 hover:text-blue-600 transition-colors underline decoration-stone-300 underline-offset-4 hover:decoration-blue-400"
            >
              SaveAnswer
            </a>
            <span class="text-xs text-stone-400 font-mono">· Chrome 扩展</span>
          </div>
          <p class="text-sm text-stone-600 leading-relaxed">
            面向开发者的本地优先 AI 知识库。一键提取 ChatGPT、Claude、DeepSeek、Gemini 等主流大模型回答，直写本地 Obsidian，无需云端中转。
            <a href="/saveanswer/" class="text-xs text-blue-600 hover:underline ml-1">访问项目主页 →</a>
          </p>
        </li>
      </ul>
    </section>

    <!-- 3. 文章与思考 (作为博客主页的核心主体) -->
    <section class="space-y-5 pt-2">
      <div class="flex items-baseline justify-between border-b border-stone-200/80 pb-2">
        <h2 class="text-xs font-mono uppercase tracking-wider text-stone-500 font-medium">文章与思考</h2>
        <a href="/blog" class="text-xs text-stone-400 hover:text-stone-700 transition-colors">
          全部文章 →
        </a>
      </div>

      <div class="space-y-6">
        {posts.map((post) => (
          <article class="space-y-1.5 group">
            <div class="flex items-center justify-between text-xs text-stone-400 font-mono">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              <div class="flex items-center gap-1.5">
                {post.data.tags.slice(0, 2).map((tag: string) => (
                  <span class="text-stone-400">#{tag}</span>
                ))}
              </div>
            </div>

            <h3 class="text-base font-medium text-stone-900 group-hover:text-blue-600 transition-colors">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h3>

            <p class="text-sm text-stone-600 leading-relaxed line-clamp-2">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
