---
import Layout from '../layouts/Layout.astro';

const supportedPlatforms = [
  { name: 'ChatGPT', icon: '/saveanswer/assets/icons/chatgpt.svg' },
  { name: 'Claude', icon: '/saveanswer/assets/icons/claude.svg' },
  { name: 'DeepSeek', icon: '/saveanswer/assets/icons/deepseek.svg' },
  { name: 'Gemini', icon: '/saveanswer/assets/icons/gemini.svg' },
  { name: 'Qwen', icon: '/saveanswer/assets/icons/qwen.svg' },
  { name: 'Grok', icon: '/saveanswer/assets/icons/grok.svg' },
  { name: 'Obsidian', icon: '/saveanswer/assets/icons/obsidian.svg' },
];
---

<Layout
  title="自研项目 — 庄谷 (charmlynn)"
  description="庄谷 (charmlynn) 的自研软件与开源项目，包括面向开发者的本地优先 AI 知识库扩展 SaveAnswer。"
>
  <div class="space-y-12">
    <!-- Header -->
    <section class="monograph-section">
      <div class="rail-label">
        <span>项目索引</span>
      </div>
      <div class="space-y-3">
        <h1 class="font-editorial text-[26px] sm:text-[28px] font-semibold tracking-tight leading-tight" style="color: var(--ink);">
          自研项目
        </h1>
        <p class="text-[15.5px] leading-relaxed" style="color: var(--ink-secondary);">
          围绕真实工程痛点打磨的独立工具。坚持本地优先（Local-first）、开放纯文本格式与零隐私追踪。
        </p>
      </div>
    </section>

    <hr class="border-0 border-t" style="border-color: var(--border-hairline);" />

    <!-- Featured Product: SaveAnswer -->
    <section class="monograph-section">
      <div class="rail-label flex-col items-start gap-1">
        <span>主力产品</span>
        <span class="font-tabular text-[12px]" style="color: var(--accent);">Active · v1.1.0</span>
      </div>

      <div class="surface-card surface-card-link p-6 sm:p-7 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <img
              src="/saveanswer/assets/icon.png"
              alt="SaveAnswer"
              width="44"
              height="44"
              class="w-11 h-11 rounded-[10px] border p-0.5 shrink-0"
              style="border-color: var(--border-hairline); background: var(--bg-canvas);"
            />
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-[18px] font-semibold tracking-tight whitespace-nowrap" style="color: var(--ink);">SaveAnswer</h2>
                <span
                  class="font-tabular text-[11.5px] px-2 py-0.5 rounded-full border whitespace-nowrap"
                  style="color: var(--accent); background: var(--accent-soft); border-color: var(--accent-border);"
                >
                  Chrome Store
                </span>
              </div>
              <p class="text-[13.5px] mt-0.5" style="color: var(--ink-muted);">
                一键保存高价值 AI 回答，建立本地私域知识库
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 shrink-0">
            <a
              href="/saveanswer/"
              class="inline-flex items-center gap-1 h-9 px-3.5 rounded-lg border text-[13.5px] font-medium transition-colors hover:border-[var(--border-strong)]"
              style="border-color: var(--border-hairline); color: var(--ink); background: var(--bg-canvas);"
            >
              <span>访问产品主页</span>
              <span class="arrow-step">→</span>
            </a>
            <a
              href="https://chromewebstore.google.com/detail/saveanswer-save-ai-answer/iminapemlncanmmaadedieifgkaeoljm"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 h-9 px-3.5 rounded-lg text-[13.5px] font-medium text-white transition-opacity hover:opacity-90"
              style="background-color: var(--accent);"
            >
              <span>安装扩展</span>
              <span class="arrow-step-ne text-[11px]">↗</span>
            </a>
          </div>
        </div>

        <p class="text-[15px] leading-relaxed" style="color: var(--ink-secondary);">
          原生内嵌主流大模型对话页面，支持 420px 浮窗敏捷秒查、全屏三栏工作台深度研读，并通过浏览器文件系统接口直接写入本地 Obsidian Vault。无中心化云端服务器，所有知识资产 100% 留存在你自己的硬盘上。
        </p>

        <!-- Real Brand Icons Strip (Rule 7: Real icons in their own colours) -->
        <div class="flex flex-wrap items-center gap-2 pt-0.5">
          {supportedPlatforms.map((p) => (
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[12.5px] border"
              style="background: var(--bg-canvas); border-color: var(--border-hairline); color: var(--ink-secondary);"
            >
              <img src={p.icon} alt="" width="14" height="14" class="w-3.5 h-3.5 shrink-0" />
              <span>{p.name}</span>
            </span>
          ))}
        </div>

        <!-- Product Frame Preview (No caption underneath per House Rule 1; subtle zoom on hover) -->
        <a
          href="/saveanswer/"
          class="group block rounded-lg overflow-hidden border"
          style="border-color: var(--border-hairline); background: var(--bg-subtle);"
          aria-label="查看 SaveAnswer 工作台完整演示"
        >
          <img
            src="/saveanswer/assets/workspace-preview.png"
            alt="SaveAnswer Desktop Workspace"
            class="w-full h-auto transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            loading="lazy"
          />
        </a>
      </div>
    </section>

    <hr class="border-0 border-t" style="border-color: var(--border-hairline);" />

    <!-- Open Source & Site Architecture -->
    <section class="monograph-section">
      <div class="rail-label">
        <span>开源与站点</span>
      </div>

      <div class="spotlight-list space-y-4">
        <a
          href="https://github.com/charmlynn/charmlynn.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="spotlight-item ledger-row group block rounded-lg -mx-3 px-3 py-2.5 transition-colors hover:bg-[var(--bg-subtle)]/65"
        >
          <div class="flex items-baseline gap-3">
            <h3 class="text-[15.5px] font-medium group-hover:text-[var(--accent)] transition-colors" style="color: var(--ink);">
              charmlynn.github.io
            </h3>
            <span class="font-tabular text-[12px]" style="color: var(--ink-faint);">Astro 7 · Tailwind v4</span>
            <span class="leader-line" aria-hidden="true"></span>
            <span class="font-tabular text-[13px] shrink-0 inline-flex items-center gap-1" style="color: var(--ink-muted);">
              <span>GitHub</span>
              <span class="arrow-step-ne text-[11px]">↗</span>
            </span>
          </div>
          <p class="text-[14.5px] leading-relaxed mt-1" style="color: var(--ink-secondary);">
            本站源码。采用瑞士网格排版、零框架运行时开销与纯静态构建，随时可无缝迁移至任意独立域名与自有服务器。
          </p>
        </a>
      </div>
    </section>
  </div>
</Layout>
