---
import Layout from '../layouts/Layout.astro';

const legacyPosts = [
  {
    title: "指标计算字典",
    date: "2018.12.13",
    tag: "数据仓库",
    desc: "互联网流量分析与用户行为度量常见指标的计算口径与字典规范。",
  },
  {
    title: "数据仓库成功的评价标准",
    date: "2018.11.07",
    tag: "数据仓库",
    desc: "剖析数据仓库项目高失败率的成因，探讨工程落地与业务价值的评价维度。",
  },
  {
    title: "Struct Streaming 项目开发",
    date: "2018.11.07",
    tag: "Spark",
    desc: "Spark 2.2+ Structured Streaming 实时流计算组件实践与开发要点。",
  },
  {
    title: "数据仓库问题总结 (Super Basic)",
    date: "2018.11.06",
    tag: "数据架构",
    desc: "总线矩阵、一致性维度与事实表设计的核心概念梳理。",
  },
  {
    title: "Serialize Non-ActiveRecord Model Using ActiveModel::Serializer in Rails",
    date: "2018.10.25",
    tag: "Rails",
    desc: "在 Rails 中针对非数据库持久化模型进行结构化 JSON 序列化输出。",
  },
  {
    title: "Use `raise_error` matcher in Rspec",
    date: "2018.10.25",
    tag: "RSpec",
    desc: "RSpec 单行异常断言语法的边界行为与正确写法。",
  },
  {
    title: "Plot Financial Data Using Matplotlib (super basic)",
    date: "2018.10.23",
    tag: "Python",
    desc: "使用 Pandas 与 Matplotlib 对金融时序数据进行快速可视化。",
  },
];
---

<Layout
  title="2018 历史归档 — 庄谷 (charmlynn)"
  description="庄谷 (charmlynn) 2018 年旧版博客时期关于数据工程、Spark 与后端研发的历史文章归档。"
>
  <div class="space-y-12">
    <section class="monograph-section">
      <div class="rail-label">
        <a href="/blog" class="hover:text-[var(--ink)] transition-colors">← 返回文章</a>
      </div>
      <div class="space-y-3">
        <h1 class="font-editorial text-[26px] sm:text-[28px] font-semibold tracking-tight leading-tight" style="color: var(--ink);">
          2018 历史技术归档
        </h1>
        <p class="text-[15px] leading-relaxed" style="color: var(--ink-secondary);">
          收录六年前旧站点（Jekyll 时期）撰写的技术笔记目录。因目前写作重心聚焦于 AI 思考与独立开发，旧文已移出主信息流，原始 Markdown 存档保留在仓库 <code class="font-tabular text-[13px] px-1.5 py-0.5 rounded" style="background: var(--bg-subtle); color: var(--ink);">archive_legacy_posts/</code> 目录中。
        </p>
      </div>
    </section>

    <hr class="border-0 border-t" style="border-color: var(--border-hairline);" />

    <section class="monograph-section">
      <div class="rail-label font-tabular">
        <span>2018</span>
      </div>

      <div class="space-y-5">
        {legacyPosts.map((post) => (
          <div class="ledger-row space-y-1">
            <div class="flex items-baseline gap-3">
              <h2 class="text-[15.5px] font-medium leading-snug" style="color: var(--ink);">
                {post.title}
              </h2>
              <span class="leader-line hidden sm:block" aria-hidden="true"></span>
              <span class="font-tabular text-[12.5px] shrink-0" style="color: var(--ink-faint);">
                {post.tag} · {post.date}
              </span>
            </div>
            <p class="text-[14px] leading-relaxed" style="color: var(--ink-muted);">
              {post.desc}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
