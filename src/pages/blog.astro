---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="文章与思考 - 庄谷 (charmlynn)"
  description="庄谷 (charmlynn) 关于 AI、Local-first 架构与独立开发的技术随笔。"
>
  <div class="space-y-8">
    <div class="space-y-2 border-b border-stone-200/80 pb-4">
      <h1 class="text-2xl font-semibold tracking-tight text-stone-900">文章与思考</h1>
      <p class="text-stone-600 text-sm leading-relaxed">
        记录在 AI 时代关于软件工程、本地优先（Local-first）设计与自研工具开发的技术随笔。
      </p>
    </div>

    <!-- 博客文章列表 -->
    <div class="space-y-8">
      {posts.map((post) => (
        <article class="space-y-1.5 group">
          <div class="flex items-center justify-between text-xs text-stone-400 font-mono">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <div class="flex items-center gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="text-stone-400">#{tag}</span>
              ))}
            </div>
          </div>

          <h2 class="text-base sm:text-lg font-medium text-stone-900 group-hover:text-blue-600 transition-colors">
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </h2>

          <p class="text-sm text-stone-600 leading-relaxed">
            {post.data.description}
          </p>
        </article>
      ))}
    </div>

    <!-- 历史归档入口 -->
    <div class="pt-6 border-t border-stone-200/80 text-xs text-stone-500 flex items-center justify-between">
      <span>旧版博客（2018 年技术文章）已移出主列表。</span>
      <a href="/archive" class="text-stone-700 hover:text-blue-600 underline underline-offset-2">
        查看 2018 历史技术归档 →
      </a>
    </div>
  </div>
</Layout>
