---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "庄谷 (charmlynn) - 个人主页与技术思考",
  description = "庄谷 (charmlynn) 的个人主页。记录 AI 思考、Local-first 产品开发与自研工具实践。",
  image = "/saveanswer/assets/workspace-preview.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://charmlynn.github.io');
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/saveanswer/assets/icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="庄谷 (charmlynn) RSS Feed" href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#faf9f6] text-stone-900 selection:bg-stone-200">
    <!-- Header -->
    <header class="border-b border-stone-200/80 bg-[#faf9f6]/90 backdrop-blur-sm sticky top-0 z-40">
      <div class="max-w-2xl mx-auto px-5 h-14 flex items-center justify-between">
        <!-- Brand / Name -->
        <a href="/" class="flex items-baseline gap-2 group">
          <span class="font-medium text-base text-stone-900 group-hover:text-blue-600 transition-colors">庄谷</span>
          <span class="text-xs text-stone-400 font-mono">charmlynn</span>
        </a>

        <!-- Navigation -->
        <nav class="flex items-center gap-1 sm:gap-4 text-sm">
          <a
            href="/"
            class={`px-2 py-1 rounded transition-colors ${
              currentPath === '/' ? 'text-stone-950 font-medium' : 'text-stone-500 hover:text-stone-900'
            }`}
          >
            首页
          </a>
          <a
            href="/blog"
            class={`px-2 py-1 rounded transition-colors ${
              currentPath.startsWith('/blog') ? 'text-stone-950 font-medium' : 'text-stone-500 hover:text-stone-900'
            }`}
          >
            文章
          </a>
          <a
            href="/projects"
            class={`px-2 py-1 rounded transition-colors ${
              currentPath.startsWith('/projects') ? 'text-stone-950 font-medium' : 'text-stone-500 hover:text-stone-900'
            }`}
          >
            项目
          </a>
          <a
            href="/about"
            class={`px-2 py-1 rounded transition-colors ${
              currentPath.startsWith('/about') ? 'text-stone-950 font-medium' : 'text-stone-500 hover:text-stone-900'
            }`}
          >
            关于
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/charmlynn"
            target="_blank"
            rel="noopener noreferrer"
            class="text-stone-400 hover:text-stone-700 transition-colors ml-1 p-1"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content: Focused, readable column -->
    <main class="flex-1 max-w-2xl w-full mx-auto px-5 py-10 sm:py-14">
      <slot />
    </main>

    <!-- Minimalist Footer -->
    <footer class="border-t border-stone-200/80 py-8 text-xs text-stone-500">
      <div class="max-w-2xl mx-auto px-5 flex flex-col sm:flex-row items-center justify-between gap-3">
        <span>© 2026 庄谷 (charmlynn)</span>
        <div class="flex items-center gap-4">
          <a href="/archive" class="hover:text-stone-800 transition-colors">2018 旧文存档</a>
          <a href="/rss.xml" class="hover:text-stone-800 transition-colors">RSS</a>
          <a href="https://github.com/charmlynn" target="_blank" rel="noopener noreferrer" class="hover:text-stone-800 transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
