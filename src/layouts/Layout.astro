---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  wide?: boolean;
}

const {
  title = "庄谷 (charmlynn) — 工程师与独立开发者",
  description = "庄谷 (charmlynn) 的个人博客与项目索引。专注大模型应用、Local-first 软件架构与个人知识工程。",
  image = "/saveanswer/assets/workspace-preview.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://charmlynn.github.io');
const currentPath = Astro.url.pathname;

const isHome = currentPath === '/';
const isBlog = currentPath.startsWith('/blog') || currentPath.startsWith('/archive');
const isProjects = currentPath.startsWith('/projects');
const isAbout = currentPath.startsWith('/about');
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/saveanswer/assets/icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="庄谷 (charmlynn) RSS Feed" href="/rss.xml" />

    <!-- Strict default to Mineral Paper Light; restore user's manual choice if explicitly toggled -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('charmlynn-theme');
          if (saved === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <!-- Subtle top architectural dot grid -->
    <div class="page-atmosphere" aria-hidden="true"></div>

    <!-- Fixed-height Architectural Header -->
    <header
      class="sticky top-0 z-30 border-b backdrop-blur-md"
      style="background-color: var(--bg-elevated); border-color: var(--border-hairline);"
    >
      <div class="max-w-[780px] mx-auto px-4 sm:px-6 h-15 sm:h-16 flex items-center justify-between gap-2 sm:gap-4">
        <!-- Brand Mark & Monogram -->
        <a href="/" class="inline-flex items-center gap-2 sm:gap-2.5 group shrink-0">
          <span
            class="w-6 h-6 rounded-[6px] flex items-center justify-center border transition-colors shrink-0"
            style="border-color: var(--border-strong); background: var(--bg-surface); color: var(--ink);"
            aria-hidden="true"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 5.5L8 3L13 5.5M3 10.5L8 13L13 10.5M3 8L8 10.5L13 8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="font-medium text-[15px] sm:text-[15.5px] tracking-tight whitespace-nowrap" style="color: var(--ink);">庄谷</span>
          <span class="font-tabular text-[12.5px] hidden sm:inline" style="color: var(--ink-muted);">charmlynn</span>
        </a>

        <!-- Navigation & Utilities -->
        <div class="flex items-center gap-2.5 sm:gap-6">
          <nav class="flex items-center gap-3 sm:gap-5" aria-label="主导航">
            <a href="/" class="nav-word" aria-current={isHome ? 'page' : undefined}>首页</a>
            <a href="/blog" class="nav-word" aria-current={isBlog ? 'page' : undefined}>文章</a>
            <a href="/projects" class="nav-word" aria-current={isProjects ? 'page' : undefined}>项目</a>
            <a href="/about" class="nav-word" aria-current={isAbout ? 'page' : undefined}>关于</a>
          </nav>

          <div class="h-3.5 w-[1px] hidden sm:block" style="background-color: var(--border-strong);"></div>

          <div class="flex items-center gap-1.5">
            <!-- ⌘K Command Palette Trigger -->
            <button
              type="button"
              data-open-cmd
              class="inline-flex items-center gap-2 h-8 px-2 sm:px-2.5 rounded-lg border text-[13px] cursor-pointer transition-colors hover:border-[var(--border-strong)]"
              style="background: var(--bg-surface); border-color: var(--border-hairline); color: var(--ink-muted);"
              aria-label="打开快速检索面板 (快捷键 Command + K)"
              title="快速检索 (⌘K)"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span class="font-tabular text-[11.5px] hidden sm:inline" style="color: var(--ink-faint);">⌘K</span>
            </button>

            <!-- Paper / Dusk Theme Switch -->
            <button
              id="theme-toggle"
              type="button"
              class="w-8 h-8 rounded-lg border flex items-center justify-center cursor-pointer transition-colors hover:border-[var(--border-strong)]"
              style="background: var(--bg-surface); border-color: var(--border-hairline); color: var(--ink-muted);"
              aria-label="切换浅色纸张与暮色外观"
              title="切换阅读外观"
            >
              <svg id="icon-sun" class="w-3.5 h-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="4" />
                <path stroke-linecap="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0l-1.414-1.414M7.05 7.05L5.636 5.636" />
              </svg>
              <svg id="icon-moon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="relative z-10 flex-1 w-full max-w-[780px] mx-auto px-4 sm:px-6 pt-10 pb-16 sm:pt-16 sm:pb-24">
      <slot />
    </main>

    <!-- Architectural Footer -->
    <footer class="relative z-10 border-t" style="border-color: var(--border-hairline);">
      <div class="max-w-[780px] mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[13px]" style="color: var(--ink-muted);">
        <div class="flex items-center gap-2">
          <span class="font-medium" style="color: var(--ink-secondary);">庄谷</span>
          <span style="color: var(--ink-faint);">·</span>
          <span class="font-tabular">© {new Date().getFullYear()} charmlynn</span>
        </div>

        <div class="flex items-center gap-5">
          <a href="/archive" class="hover:text-[var(--ink)] transition-colors">2018 归档</a>
          <a href="/rss.xml" class="hover:text-[var(--ink)] transition-colors font-tabular">RSS</a>
          <a
            href="https://github.com/charmlynn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 hover:text-[var(--ink)] transition-colors"
          >
            <span>GitHub</span>
            <span class="arrow-step-ne text-[11px]">↗</span>
          </a>
        </div>
      </div>
    </footer>

    <CommandPalette />

    <script is:inline>
      (() => {
        const html = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');

        function syncIcons() {
          const isDark = html.getAttribute('data-theme') === 'dark';
          sun?.classList.toggle('hidden', !isDark);
          moon?.classList.toggle('hidden', isDark);
        }

        function toggleTheme() {
          const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          try {
            localStorage.setItem('charmlynn-theme', next);
          } catch (_) {}
          syncIcons();
        }

        window.__toggleSiteTheme = toggleTheme;
        btn?.addEventListener('click', toggleTheme);
        syncIcons();
      })();
    </script>
  </body>
</html>
